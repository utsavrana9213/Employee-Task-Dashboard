PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Local development stores data in ./data/taskflow.db.
# Vercel deployments require a persistent Turso database:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: override the local demo account before first initialization.
DEMO_ADMIN_EMAIL=admin@gmail.com
DEMO_ADMIN_PASSWORD=
